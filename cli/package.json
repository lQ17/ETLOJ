{
  "name": "@etloj/cli",
  "version": "0.1.0",
  "description": "Command-line client for querying ETLOJ problems",
  "type": "module",
  "bin": {
    "etloj": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.8.0",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.22.0",
    "typescript": "^5.7.3"
  }
}
