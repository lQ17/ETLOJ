# Copy to docker/.env.docker before running Docker Compose.
# Use only letters, numbers, '-' and '_' in MYSQL_PASSWORD because it is
# embedded in DATABASE_URL without extra URL encoding.
MYSQL_ROOT_PASSWORD=replace-with-a-long-root-password
MYSQL_PASSWORD=replace-with-a-long-url-safe-password
JWT_SECRET=replace-with-at-least-32-random-characters
JUDGE_SECRET=replace-with-an-independent-random-secret
ADMIN_SEED_PASSWORD=replace-with-a-strong-initial-admin-password
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

HTTP_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
MCP_RATE_LIMIT_MAX=60
MCP_RATE_LIMIT_WINDOW_MS=60000

# Optional administrator testcase MCP limits. Keep the conservative defaults
# unless the deployment has reviewed the size, count, and write-rate needs.
MCP_TESTCASE_MAX_FILE_BYTES=1048576
MCP_TESTCASE_READ_CHUNK_CHARS=32768
MCP_TESTCASE_READ_MAX_CHARS=65536
MCP_TESTCASE_MAX_COUNT=1000
MCP_ADMIN_WRITE_RATE_LIMIT_MAX=10
MCP_ADMIN_WRITE_RATE_LIMIT_WINDOW_MS=60000
