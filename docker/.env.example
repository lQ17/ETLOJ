# Copy to docker/.env.docker before running Docker Compose.
# Use only letters, numbers, '-' and '_' in MYSQL_PASSWORD because it is
# embedded in DATABASE_URL without extra URL encoding.
MYSQL_ROOT_PASSWORD=replace-with-a-long-root-password
MYSQL_PASSWORD=replace-with-a-long-url-safe-password
JWT_SECRET=replace-with-at-least-32-random-characters
JUDGE_SECRET=replace-with-an-independent-random-secret
ADMIN_SEED_PASSWORD=replace-with-a-strong-initial-admin-password
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

HTTP_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
